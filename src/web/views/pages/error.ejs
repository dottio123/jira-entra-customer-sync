<% const n = errorNotice; %>
<% if (principal) { %>
  <header class="page-header">
    <div>
      <h1><%= n.title %></h1>
    </div>
  </header>
  <section class="card narrow">
    <% if (n.text) { %><p><%= n.text %></p><% } %>
    <div class="form-actions">
      <a class="button button-primary" href="/overview"><%- icon('arrow-left') %><span>Go to Overview</span></a>
    </div>
    <p class="small muted">Error <%= statusCode %></p>
  </section>
<% } else { %>
  <div class="auth-panel">
    <div class="auth-card">
      <h1><%= n.title %></h1>
      <% if (n.text) { %><p><%= n.text %></p><% } %>
      <a class="button button-primary button-block" href="/login">Go to sign in</a>
      <p class="small muted">Error <%= statusCode %></p>
    </div>
  </div>
<% } %>

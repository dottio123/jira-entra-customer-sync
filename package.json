{
  "name": "entra-jsm-customer-sync",
  "version": "1.0.0",
  "description": "Keeps Jira Service Management customer details in sync with Microsoft Entra ID, with preview, approval, and verified updates",
  "private": true,
  "scripts": {
    "start": "node dist/web/index.js",
    "web": "node dist/web/index.js",
    "web:dev": "tsx src/web/index.ts",
    "cli": "node dist/index.js",
    "cli:dev": "tsx src/index.ts",
    "cli:compare-reports": "tsx src/scripts/compare-reports.ts",
    "oauth:login": "tsx src/scripts/atlassian-oauth-login.ts",
    "oauth:status": "tsx src/scripts/atlassian-oauth-status.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --configLoader=native",
    "test:watch": "vitest --configLoader=native",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "entra-id",
    "azure-ad",
    "jira-service-management",
    "jsm",
    "sync"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "ejs": "^6.0.1",
    "fastify": "^5.12.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}

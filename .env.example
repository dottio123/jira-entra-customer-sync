# =============================================================================
# Entra to Jira Customer Sync — configuration
# =============================================================================
# Quick start
#   1. Copy this file:            cp .env.example .env
#   2. Fill in sections 1 to 4.   Leave anything you don't need blank or commented out.
#   3. Start the service:         docker compose up -d
#   4. Open PUBLIC_BASE_URL in a browser and sign in.
#
# Never commit .env. Secrets can also be supplied as files (the *_FILE variables),
# mounted read-only from ./deployment-secrets to /run/secrets by compose.yaml.
# A blank value (NAME=) is treated exactly like an unset variable.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Web access
# -----------------------------------------------------------------------------
# The address people type in their browser. Required in production.
# Anything other than localhost/127.0.0.1 must use https://.
# The Jira sign-in callback is always <PUBLIC_BASE_URL>/auth/atlassian/callback.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Host network interface and port that Docker publishes the service on.
# Use 127.0.0.1 when a reverse proxy on the same machine provides HTTPS.
WEB_BIND_IP=0.0.0.0
WEB_BIND_PORT=8080

# Reverse proxy trust for X-Forwarded-* headers:
#   false (no proxy), true (trust every hop), or the proxy's IP/CIDR, e.g. 127.0.0.1
WEB_TRUST_PROXY=false

# TESTING ONLY: allow plain HTTP on a non-loopback address (for example a LAN IP).
# Never enable this in production.
# ALLOW_INSECURE_REMOTE_HTTP=false

# Log detail: debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 2. Administrator
# -----------------------------------------------------------------------------
# Used only on first start, when no account exists yet. You must change the
# password at first sign-in (12 characters minimum).
ADMIN_USERNAME=admin
# Recommended: put the password in ./deployment-secrets/admin_initial_password
ADMIN_INITIAL_PASSWORD_FILE=/run/secrets/admin_initial_password
# Alternative for local development only:
# ADMIN_INITIAL_PASSWORD=


# -----------------------------------------------------------------------------
# 3. Microsoft Entra ID (directory source)
# -----------------------------------------------------------------------------
# App registration with the Microsoft Graph *application* permission User.Read.All
# (admin consent granted). Find the IDs on the app registration's Overview page.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Or read the client secret from a file instead:
# MICROSOFT_CLIENT_SECRET_FILE=/run/secrets/microsoft_client_secret


# -----------------------------------------------------------------------------
# 4. Atlassian Jira Service Management (customer target)
# -----------------------------------------------------------------------------
# Jira service desk ID(s) whose existing customers are kept in sync, comma-separated.
JSM_SERVICE_DESK_IDS=

# OAuth 2.0 (3LO) app from https://developer.atlassian.com/console/myapps/
# Set its callback URL to <PUBLIC_BASE_URL>/auth/atlassian/callback.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
# Or read the client secret from a file instead:
# ATLASSIAN_OAUTH_CLIENT_SECRET_FILE=/run/secrets/atlassian_client_secret

# Request the one Jira write permission (write:customer.detail:jira-service-management)
# when connecting Jira. Required before updates can be applied; it does not turn updates
# on by itself — that is done in the web Settings page. After changing it, restart the
# service and choose Reconnect Jira under Connections so the permission is granted.
JIRA_WRITE_SCOPE_ALLOWED=false

# Only needed when your Atlassian account can reach more than one Jira site:
# the site address ending in .atlassian.net (not a custom domain), or its Cloud ID.
# ATLASSIAN_SITE_URL=https://your-site.atlassian.net
# ATLASSIAN_CLOUD_ID=

# Requested OAuth scopes. The default (read scopes + offline_access) is correct for
# most installs; the write scope is added automatically when JIRA_WRITE_SCOPE_ALLOWED=true.
# ATLASSIAN_OAUTH_SCOPES=offline_access read:servicedesk.customer:jira-service-management read:user:jira read:customer.detail-field:jira-service-management read:customer.profile:jira-service-management

# Optional safety check: if set, it must equal <PUBLIC_BASE_URL>/auth/atlassian/callback,
# otherwise the Connect Jira button is disabled to prevent a mismatched sign-in.
# ATLASSIAN_OAUTH_REDIRECT_URI=


# -----------------------------------------------------------------------------
# 5. Branding (optional)
# -----------------------------------------------------------------------------
APP_DISPLAY_NAME=Customer Sync
# SVG, PNG, or WebP up to 1 MB, placed in ./branding (mounted at /app/branding).
# APP_LOGO_FILE=/app/branding/logo.svg


# -----------------------------------------------------------------------------
# 6. Advanced — running without Docker (npm run start / npm run web:dev)
# -----------------------------------------------------------------------------
# compose.yaml sets these for the container; change them only for a direct Node run.
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# WEB_DATA_DIR=data
# WEB_SECRETS_DIR=secrets
# WEB_OAUTH_TOKEN_FILENAME=atlassian-oauth.json
# Container-side port, if 8080 cannot be used inside the container:
# WEB_CONTAINER_PORT=8080


# =============================================================================
# 7. Advanced — CLI diagnostics (not used by the Docker web service)
# =============================================================================
# The command-line tools (npm run cli, npm run oauth:login, npm run oauth:status)
# offer read-only diagnostics and legacy, tightly bounded write paths.
# See docs/cli/README.md before using any of these. All defaults are read-only.
#
# Sources:  DIRECTORY_SOURCE=memory|entra    CUSTOMER_TARGET=memory|jira-readonly
# DIRECTORY_SOURCE=memory
# CUSTOMER_TARGET=memory
# JSM_API_AUTH_MODE=oauth-3lo
# SYNC_SCOPE_SOURCE=entra
# SYNC_DRY_RUN=true
#
# CLI OAuth helper (loopback callback, different from the web callback):
# ATLASSIAN_OAUTH_TOKEN_PATH=secrets/atlassian-oauth.json
#
# Microsoft Graph tuning:
# INCLUDE_GUEST_USERS=false
# MANAGER_LOOKUP_CONCURRENCY=3
# GRAPH_MAX_RETRIES=3
# GRAPH_RETRY_DELAY_MS=500
#
# Legacy API-token authentication (JSM_API_AUTH_MODE=basic-api-token):
# ATLASSIAN_USER_EMAIL=
# ATLASSIAN_API_TOKEN=
#
# Read-only validation modes:
# DISCOVERY_ONLY=false
# JIRA_VALIDATE_EXISTING_CUSTOMER=false
# JIRA_TEST_CUSTOMER_EMAIL=
# JIRA_VALIDATE_CUSTOMER_ENUMERATION=false
# JIRA_INVESTIGATE_AUTH=false
# CUSTOMER_ENUMERATION_VALIDATED=false
#
# End-to-end dry run:
# END_TO_END_DRY_RUN=false
# END_TO_END_MAX_RECORDS=10
# FULL_DIRECTORY_DRY_RUN_ACKNOWLEDGED=false
# JIRA_LOOKUP_CONCURRENCY=2
# DRY_RUN_REPORT_PATH=reports/dry-run-report.json
#
# Single-customer write pilot (requires JIRA_WRITE_SCOPE_ALLOWED=true):
# PILOT_WRITE_ENABLED=false
# PILOT_WRITE_CONFIRMATION=
# PILOT_WRITE_MAX_FIELDS=1
# JIRA_PILOT_CUSTOMER_EMAIL=
# PILOT_WRITE_REPORT_PATH=reports/pilot-write-report.json
#
# Bounded rollout writer (requires JIRA_WRITE_SCOPE_ALLOWED=true):
# ROLLOUT_WRITE_ENABLED=false
# ROLLOUT_PREFLIGHT_ONLY=false
# ROLLOUT_WRITE_CONFIRMATION=
# ROLLOUT_WRITE_MAX_CUSTOMERS=1
# ROLLOUT_WRITE_MAX_FIELDS_PER_CUSTOMER=1
# ROLLOUT_WRITE_MIN_INTERVAL_MS=5000
# ROLLOUT_APPROVED_REPORT_PATH=reports/jira-first-dry-run-report.json
# ROLLOUT_APPROVED_REPORT_SHA256=
# ROLLOUT_WRITE_REPORT_PATH=reports/bounded-rollout-write-report.json
